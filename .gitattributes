# =============================================================================
# Git 属性配置 - 强制 LF 行尾，避免 CRLF 警告
# =============================================================================

*               text=auto eol=lf
*.py            text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.xml           text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.json          text eol=lf
*.launch        text eol=lf
*.launch.py     text eol=lf
*.cfg           text eol=lf
*.sh            text eol=lf
*.bash          text eol=lf

*.png           binary
*.jpg           binary
*.jpeg          binary
*.bag           binary
*.db3           binary
*.mcap          binary
*.pbstream      binary
*.pcd           binary
*.bin           binary
*.npy           binary
*.npz           binary
*.pkl           binary

*.csv           text eol=lf